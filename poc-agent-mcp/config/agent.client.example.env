# Copy to bridge/.env — DO NOT COMMIT real secrets

PORT=3978

# Tenant Entra where Symbio Copilot Studio agent is hosted
CLIENT_TENANT_ID=00000000-0000-0000-0000-000000000000

# From Copilot Studio → Settings → Advanced → Metadata
ENVIRONMENT_ID=4f680da5-2dcc-eace-a4eb-9787feeef742
SCHEMA_NAME=cr10d_symbiod365uatmcp_REPLACE_ME

# Entra app registration used by the bridge (Power Platform API: CopilotStudio.Copilots.Invoke)
APP_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional: paste full Microsoft 365 Agents SDK connection string from Copilot Studio → Application
# DIRECT_CONNECT_URL=https://....environment.api.powerplatform.com/copilotstudio/...

# Shared secret between HSO façade connected agent and this bridge
BRIDGE_API_KEY=replace-with-long-random-string

# F&O reference (documentation only — MCP is configured inside Copilot Studio client agent)
FO_MCP_URL=https://symbiouat.sandbox.operations.eu.dynamics.com/mcp
FO_BASE_URL=https://symbiouat.sandbox.operations.eu.dynamics.com/
ADO_ORG_URL=https://dev.azure.com/symbiofcell/
ADO_MCP_URL=https://mcp.dev.azure.com/symbiofcell
