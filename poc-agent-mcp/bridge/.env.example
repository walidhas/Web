# Copy to .env — NEVER commit real secrets

PORT=3978
MOCK_MODE=false

# === Target: client Copilot Studio agent ===
CLIENT_TENANT_ID=00000000-0000-0000-0000-000000000000
# Prefer CONNECTION_STRING from Channels → Web/Native → Microsoft 365 Agents SDK
CONNECTION_STRING=
# Or metadata fallback:
ENVIRONMENT_ID=
SCHEMA_NAME=

# === Entra app used by the bridge ===
APP_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Lab: interactive | Enterprise Azure: client_credentials (+ APP_CLIENT_SECRET)
AUTH_MODE=interactive
# APP_CLIENT_SECRET=

# === Shared with Copilot Studio façade Connected agent (x-api-key) ===
# Use alphanumeric only (avoid / + =)
BRIDGE_API_KEY=ReplaceWithLongRandomAlphanumericKey
