/// <summary>
/// Form event handlers for <c>SalesAgreementCreate</c>.
/// When the agreement classification changes, defaults the commitment type
/// from <c>AgreementClassification.EOLDefaultCommitmentType</c>.
/// </summary>
public class EOLSalesAgreementCreateFormHandler
{
    /// <summary>
    /// On control <c>SalesAgreementHeader_AgreementClassification</c> modified, copies
    /// <c>AgreementClassification.EOLDefaultCommitmentType</c> into
    /// <c>SalesAgreementHeader.DefaultAgreementLineType</c>.
    /// </summary>
    /// <param name="sender">
    /// The modified form control.
    /// </param>
    /// <param name="e">
    /// Form control event arguments.
    /// </param>
    [FormControlEventHandler(formControlStr(SalesAgreementCreate, SalesAgreementHeader_AgreementClassification), FormControlEventType::Modified)]
    public static void SalesAgreementHeader_AgreementClassification_OnModified(FormControl sender, FormControlEventArgs e)
    {
        FormRun formRun = sender.formRun();
        FormDataSource salesAgreementHeaderDs = formRun.dataSource(formDataSourceStr(SalesAgreementCreate, SalesAgreementHeader));
        SalesAgreementHeader salesAgreementHeader = salesAgreementHeaderDs.cursor();
        AgreementClassification agreementClassification;

        agreementClassification = AgreementClassification::find(salesAgreementHeader.AgreementClassification);

        salesAgreementHeader.DefaultAgreementLineType = agreementClassification.EOLDefaultCommitmentType;
    }

}
