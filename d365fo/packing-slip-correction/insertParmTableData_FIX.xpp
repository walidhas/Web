/// <summary>
/// Drop-in replacement for insertParmTableData.
/// Correction is always posted on InventLocation.EOLWMSLocationIdDefaultVirtualReceipt.
/// </summary>
private void insertParmTableData()
{
    InventDim       inventDim;
    InventLocation  inventLocation;
    WMSLocationId   virtualLocationId;
    Qty             newReceiveQty;

    newReceiveQty = 7;

    purchFormLetterParmData = PurchFormletterParmData::newData(
        DocumentStatus::PackingSlip,
        VersioningUpdateType::Initial);

    purchFormLetterParmData.init();
    purchFormLetterParmData.parmOnlyCreateParmUpdate(true);
    purchFormLetterParmData.createData(false);

    purchParmUpdate = purchFormLetterParmData.parmParmUpdate();

    if (!purchParmUpdate.RecId)
    {
        throw error("PurchParmUpdate was not created.");
    }

    purchParmUpdate.SpecQty = PurchUpdate::ReceiveNow;
    purchParmUpdate.DocumentDate = packingSlipDate;
    purchParmUpdate.Proforma = NoYes::No;
    purchParmUpdate.update();

    purchParmTable.clear();
    purchParmTable.initValue();
    purchParmTable.TransDate = packingSlipDate;
    purchParmTable.Ordering = DocumentStatus::PackingSlip;
    purchParmTable.ParmJobStatus = ParmJobStatus::Waiting;
    purchParmTable.initFromPurchTable(purchTable);
    purchParmTable.ParmId = purchParmUpdate.ParmId;
    purchParmTable.Num = vendPackingSlipJour.PackingSlipId;
    purchParmTable.VendPackingSlipJour = vendPackingSlipJour.RecId;
    purchParmTable.insert();

    while select purchLine
        where purchLine.PurchId == purchTable.PurchId
    {
        select firstonly vendPackingSlipTrans
            where vendPackingSlipTrans.OrigPurchid == purchLine.PurchId
               && vendPackingSlipTrans.PackingSlipId == vendPackingSlipJour.PackingSlipId
               && vendPackingSlipTrans.InventTransId == purchLine.InventTransId;

        if (!vendPackingSlipTrans.RecId)
        {
            continue;
        }

        if (vendPackingSlipTrans.InventDimId)
        {
            inventDim = InventDim::find(vendPackingSlipTrans.InventDimId);
        }
        else
        {
            inventDim = purchLine.inventDim();
        }

        inventLocation = InventLocation::find(inventDim.InventLocationId);

        if (!inventLocation.EOLWMSLocationIdDefaultVirtualReceipt)
        {
            throw error(strFmt("@EOLPackingSlip:VirtualReceiptLocNotSetup", inventDim.InventLocationId));
        }

        virtualLocationId = inventLocation.EOLWMSLocationIdDefaultVirtualReceipt;

        if (inventDim.wMSLocationId != virtualLocationId)
        {
            continue;
        }

        purchParmLine.clear();
        purchParmLine.initValue();
        purchParmLine.initFromPurchLine(purchLine);
        purchParmLine.InventDimId = inventDim.inventDimId;
        purchParmLine.ParmId = purchParmTable.ParmId;
        purchParmLine.TableRefId = purchParmTable.TableRefId;
        purchParmLine.ReceiveNow = newReceiveQty;
        purchParmLine.modifiedReceiveNow();
        purchParmLine.PreviousReceiveNow = vendPackingSlipTrans.Qty;
        purchParmLine.PreviousInventNow = vendPackingSlipTrans.InventQty;
        purchParmLine.setQty(DocumentStatus::PackingSlip, false, true);
        purchParmLine.setLineAmount();
        purchParmLine.insert();
    }
}
