/// <summary>
/// Posts a product receipt (purchase packing slip) correction so a line remains
/// received at a specific quantity. Same behavior as Procurement and sourcing
/// journals Product receipt > Correct.
/// </summary>
public class EOLPurchPackingSlipCorrector
{
    /// <summary>
    /// Corrects one posted product receipt line to a new remaining received quantity.
    /// </summary>
    /// <param name="_packingSlipId">
    /// Posted product receipt / purchase packing slip id.
    /// </param>
    /// <param name="_newReceiveQty">
    /// New quantity that must remain received (Update column on the Correct form).
    /// Must be greater than or equal to 0 and lower than the originally received quantity.
    /// </param>
    /// <param name="_purchId">
    /// Purchase order id. Recommended when packing slip ids are not unique.
    /// </param>
    /// <param name="_inventTransId">
    /// Purchase line inventory transaction id. Required when the receipt has several lines.
    /// </param>
    /// <param name="_wmsLocationId">
    /// Optional warehouse location filter.
    /// </param>
    /// <returns>
    /// The original product receipt journal that was corrected.
    /// </returns>
    public static VendPackingSlipJour correctQty(
        Num _packingSlipId,
        Qty _newReceiveQty,
        PurchId _purchId = '',
        InventTransId _inventTransId = '',
        WMSLocationId _wmsLocationId = '')
    {
        VendPackingSlipJour             packingSlipJour;
        VendPackingSlipTrans            packingSlipTrans;
        PurchTable                      purchTable;
        PurchLine                       purchLine;
        InventDim                       inventDim;
        PurchFormletterParmData         formletterParmData;
        PurchParmUpdate                 purchParmUpdate;
        PurchParmTable                  purchParmTable;
        PurchParmLine                   purchParmLine;
        PurchFormLetter                 purchFormLetter;
        TransDate                       transDate;
        Counter                         matchingLineCount;
        boolean                         lineCreated;

        if (_newReceiveQty < 0)
        {
            throw error("@EOLPackingSlip:QtyCannotBeNegative");
        }

        packingSlipJour = EOLPurchPackingSlipCorrector::findJournal(_packingSlipId, _purchId);
        purchTable = PurchTable::find(packingSlipJour.PurchId);

        if (!purchTable.RecId)
        {
            throw error(strFmt("@EOLPackingSlip:PurchOrderNotFound", packingSlipJour.PurchId));
        }

        matchingLineCount = EOLPurchPackingSlipCorrector::countMatchingLines(
            packingSlipJour,
            _inventTransId,
            _wmsLocationId);

        if (matchingLineCount == 0)
        {
            throw error("@EOLPackingSlip:PackingSlipLineNotFound");
        }

        if (!_inventTransId && matchingLineCount > 1)
        {
            throw error("@EOLPackingSlip:SpecifyLine");
        }

        transDate = DateTimeUtil::getSystemDate(DateTimeUtil::getUserPreferredTimeZone());
        lineCreated = false;

        ttsbegin;

        // Initial + init(): Correction in newData() makes createData() choose lines
        // while systemSequence is still null (NullReferenceException).
        formletterParmData = PurchFormletterParmData::newData(
            DocumentStatus::PackingSlip,
            VersioningUpdateType::Initial);

        formletterParmData.init();
        formletterParmData.parmOnlyCreateParmUpdate(true);
        formletterParmData.createData(false);

        purchParmUpdate = formletterParmData.parmParmUpdate();

        if (!purchParmUpdate.RecId)
        {
            throw error("@EOLPackingSlip:ParmBuildFailed");
        }

        purchParmUpdate.SpecQty = PurchUpdate::ReceiveNow;
        purchParmUpdate.DocumentDate = transDate;
        purchParmUpdate.Proforma = NoYes::No;
        purchParmUpdate.update();

        purchParmTable.clear();
        purchParmTable.initValue();
        purchParmTable.TransDate = transDate;
        purchParmTable.Ordering = DocumentStatus::PackingSlip;
        purchParmTable.ParmJobStatus = ParmJobStatus::Waiting;
        purchParmTable.initFromPurchTable(purchTable);
        purchParmTable.ParmId = purchParmUpdate.ParmId;
        purchParmTable.Num = packingSlipJour.PackingSlipId;
        purchParmTable.VendPackingSlipJour = packingSlipJour.RecId;
        purchParmTable.insert();

        while select packingSlipTrans
            where packingSlipTrans.OrigPurchid == packingSlipJour.PurchId
               && packingSlipTrans.PackingSlipId == packingSlipJour.PackingSlipId
               && packingSlipTrans.DeliveryDate == packingSlipJour.DeliveryDate
        {
            if (_inventTransId && packingSlipTrans.InventTransId != _inventTransId)
            {
                continue;
            }

            purchLine.clear();

            select firstonly purchLine
                where purchLine.InventTransId == packingSlipTrans.InventTransId;

            if (!purchLine.RecId)
            {
                continue;
            }

            if (_wmsLocationId)
            {
                inventDim = purchLine.inventDim();
                if (inventDim.wMSLocationId != _wmsLocationId)
                {
                    continue;
                }
            }

            if (_newReceiveQty > packingSlipTrans.Qty)
            {
                throw error(strFmt("@EOLPackingSlip:QtyMustBeLower", packingSlipTrans.Qty));
            }

            if (_newReceiveQty == packingSlipTrans.Qty)
            {
                throw error("@EOLPackingSlip:QtyUnchanged");
            }

            purchParmLine.clear();
            purchParmLine.initValue();
            purchParmLine.initFromPurchLine(purchLine);
            purchParmLine.ParmId = purchParmTable.ParmId;
            purchParmLine.TableRefId = purchParmTable.TableRefId;
            purchParmLine.ReceiveNow = _newReceiveQty;
            purchParmLine.modifiedReceiveNow();
            purchParmLine.PreviousReceiveNow = packingSlipTrans.Qty;
            purchParmLine.PreviousInventNow = packingSlipTrans.InventQty;
            purchParmLine.setQty(DocumentStatus::PackingSlip, false, true);
            purchParmLine.setLineAmount();
            purchParmLine.insert();
            lineCreated = true;
        }

        if (!lineCreated)
        {
            throw error("@EOLPackingSlip:PackingSlipLineNotFound");
        }

        ttscommit;

        try
        {
            purchFormLetter = PurchFormLetter::construct(DocumentStatus::PackingSlip);
            purchFormLetter.parmVersioningUpdateType(VersioningUpdateType::Correction);
            purchFormLetter.parmCallerTable(packingSlipJour);
            purchFormLetter.purchParmUpdate(formletterParmData.parmParmUpdate());
            purchFormLetter.parmId(purchParmTable.ParmId);
            purchFormLetter.specQty(PurchUpdate::ReceiveNow);
            purchFormLetter.transDate(transDate);
            purchFormLetter.proforma(false);
            purchFormLetter.run();
        }
        catch (Exception::Error)
        {
            error("@EOLPackingSlip:PostingFailed");
            throw;
        }

        info(strFmt("@EOLPackingSlip:PurchCorrectionPosted",
            packingSlipJour.PackingSlipId,
            _newReceiveQty));

        return packingSlipJour;
    }

    /// <summary>
    /// Finds the product receipt journal.
    /// </summary>
    /// <param name="_packingSlipId">
    /// Posted product receipt id.
    /// </param>
    /// <param name="_purchId">
    /// Optional purchase order id used to disambiguate the journal.
    /// </param>
    /// <returns>
    /// The product receipt journal.
    /// </returns>
    private static VendPackingSlipJour findJournal(
        Num _packingSlipId,
        PurchId _purchId)
    {
        VendPackingSlipJour packingSlipJour;
        VendPackingSlipJour packingSlipJourCount;

        if (!_packingSlipId)
        {
            throw error("@EOLPackingSlip:PackingSlipNotFound");
        }

        if (_purchId)
        {
            select firstonly packingSlipJour
                where packingSlipJour.PackingSlipId == _packingSlipId
                   && packingSlipJour.PurchId == _purchId;
        }
        else
        {
            select count(RecId) from packingSlipJourCount
                where packingSlipJourCount.PackingSlipId == _packingSlipId;

            if (packingSlipJourCount.RecId > 1)
            {
                throw error(strFmt("@EOLPackingSlip:AmbiguousPackingSlip", _packingSlipId));
            }

            select firstonly packingSlipJour
                where packingSlipJour.PackingSlipId == _packingSlipId;
        }

        if (!packingSlipJour.RecId)
        {
            throw error(strFmt("@EOLPackingSlip:PackingSlipNotFoundId", _packingSlipId));
        }

        return packingSlipJour;
    }

    /// <summary>
    /// Counts product receipt lines that match the optional filters.
    /// </summary>
    /// <param name="_packingSlipJour">
    /// Product receipt journal.
    /// </param>
    /// <param name="_inventTransId">
    /// Optional inventory transaction id.
    /// </param>
    /// <param name="_wmsLocationId">
    /// Optional warehouse location.
    /// </param>
    /// <returns>
    /// Number of matching receipt lines.
    /// </returns>
    private static Counter countMatchingLines(
        VendPackingSlipJour _packingSlipJour,
        InventTransId _inventTransId,
        WMSLocationId _wmsLocationId)
    {
        VendPackingSlipTrans packingSlipTrans;
        PurchLine            purchLine;
        InventDim            inventDim;
        Counter              lineCount;

        lineCount = 0;

        while select packingSlipTrans
            where packingSlipTrans.OrigPurchid == _packingSlipJour.PurchId
               && packingSlipTrans.PackingSlipId == _packingSlipJour.PackingSlipId
               && packingSlipTrans.DeliveryDate == _packingSlipJour.DeliveryDate
        {
            if (_inventTransId && packingSlipTrans.InventTransId != _inventTransId)
            {
                continue;
            }

            if (_wmsLocationId)
            {
                purchLine.clear();

                select firstonly purchLine
                    where purchLine.InventTransId == packingSlipTrans.InventTransId;

                if (!purchLine.RecId)
                {
                    continue;
                }

                inventDim = purchLine.inventDim();
                if (inventDim.wMSLocationId != _wmsLocationId)
                {
                    continue;
                }
            }

            lineCount++;
        }

        return lineCount;
    }

}
